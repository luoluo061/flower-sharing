<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.flower.mapper.CoursesManagerDetailMapper">

    <select id="selectVoByCoursesManagerIds" resultType="org.dromara.flower.domain.vo.CoursesManagerDetailVo">
        SELECT
        *
        FROM
        courses_manager_detail
        WHERE del_flag = 0 AND courses_manager_id IN
        <foreach collection="ids" separator="," open="(" close=")" item="id">
            #{id}
        </foreach>
    </select>
</mapper>
