<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.flower.mapper.CoursesTypeMapper">

    <select id="selectChildList" resultType="org.dromara.flower.domain.vo.CoursesTypeVo">
        SELECT
            id,
            dept_id,
            `name`,
            `status`,
            sort
                parent_id,
            create_time
        FROM
            courses_type
        WHERE del_flag = 0 AND parent_id IN
        <foreach collection="ids" item="id" separator="," open="(" close=")" >
            #{id}
        </foreach>
    </select>
</mapper>
