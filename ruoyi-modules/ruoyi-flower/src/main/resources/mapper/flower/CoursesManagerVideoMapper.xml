<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.flower.mapper.CoursesManagerVideoMapper">

    <select id="getVideoByCoursesManagerId" resultType="org.dromara.flower.domain.vo.CoursesManagerVideoVo">
        SELECT
            a.*,
            b.url AS address_url
        FROM
            courses_manager_video AS a
                LEFT JOIN sys_oss AS b ON a.url = b.oss_id
        WHERE a.courses_manager_id = #{id}
        ORDER BY a.sort
    </select>
    <select id="selectVoByCoursesManagerIds" resultType="org.dromara.flower.domain.vo.CoursesManagerVideoVo">
        SELECT
            *
        FROM
            courses_manager_video
        WHERE del_flag = 0 AND courses_manager_id IN
        <foreach collection="ids" separator="," open="(" close=")" item="id">
            #{id}
        </foreach>
    </select>
    <select id="selectVoByCoursesManagerId" resultType="org.dromara.flower.domain.vo.CoursesManagerVideoVo">
        SELECT
        *
        FROM
        courses_manager_video
        WHERE del_flag = 0 AND courses_manager_id = #{id}
    </select>
</mapper>
